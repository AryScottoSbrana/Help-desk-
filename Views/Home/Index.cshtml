@model HelpDesk.ViewModels.TicketIndexViewModel
@{
    ViewData["Title"] = "Chamados";
}
<style>
/* =========================================================================
   HELP DESK - Identidade visual
   Paleta verde-petróleo escura com degradê e acentos verde-limão
   ========================================================================= */

:root {
    --hd-bg-inicio:     #082C24;
    --hd-bg-fim:         #0C342C;
    --hd-bg:            linear-gradient(155deg, var(--hd-bg-inicio) 0%, var(--hd-bg-fim) 55%, #0A2620 100%);

    --hd-surface:       #0F3B31;   /* painéis/cards, levemente mais claros que o fundo */
    --hd-surface-alt:   #0A2A22;   /* cabeçalho de tabela, campos de formulário */

    --hd-border:        rgba(182, 255, 89, 0.30);  /* linhas de borda verde-limão */
    --hd-border-forte:  #9FE84B;                    /* borda/realce em foco e estados ativos */

    --hd-text:          #EAF6EE;
    --hd-text-muted:    #93B8A2;

    --hd-primary:       #0C342C;
    --hd-primary-dark:  #051D17;
    --hd-accent:        #B6FF3B;   /* verde-limão — botões, links, estado ativo */
    --hd-accent-dark:   #86CC1F;   /* contraste do hover: mesmo tom, mais escuro */
    --hd-hover:         #05201A;   /* fundo de hover em superfícies escuras */
    --hd-accent-texto:  #06231B;   /* texto escuro sobre fundo verde-limão (contraste) */

    --hd-sla-ok:        #7CE38A;
    --hd-sla-ok-bg:     rgba(124, 227, 138, 0.14);
    --hd-sla-alerta:    #F4C56B;
    --hd-sla-alerta-bg: rgba(244, 197, 107, 0.14);
    --hd-sla-estourado: #FF8A80;
    --hd-sla-estourado-bg: rgba(255, 138, 128, 0.16);
    --hd-sla-encerrado: #93B8A2;
    --hd-sla-encerrado-bg: rgba(147, 184, 162, 0.14);

    --hd-radius: 6px;
    --hd-shadow: 0 2px 6px rgba(0,0,0,.35), 0 10px 24px rgba(0,0,0,.28);
}

body.helpdesk {
    background: var(--hd-bg);
    background-attachment: fixed;
    color: var(--hd-text);
    font-family: "Segoe UI", "IBM Plex Sans", Arial, sans-serif;
    font-size: 14px;
    margin: 0;
    min-height: 100vh;
}

/* --- shell (sidebar + conteúdo) --- */
.hd-shell { display: flex; min-height: 100vh; }

.hd-sidebar {
    width: 180px;
    flex-shrink: 0;
    background: rgba(4, 20, 16, 0.35);
    border-right: 1px solid var(--hd-border);
    color: #fff;
    display: flex;
    flex-direction: column;
    backdrop-filter: blur(2px);
}

.hd-sidebar-brand { padding: 22px 22px 18px; }
.hd-sidebar-brand .marca { font-weight: 700; font-size: 16.5px; letter-spacing: .2px; color: var(--hd-text); }
.hd-sidebar-brand .sub { font-size: 12px; color: var(--hd-text-muted); margin-top: 3px; }

.hd-sidebar-nav { flex: 1; display: flex; flex-direction: column; gap: 2px; padding: 6px 12px; overflow-y: auto; }

.hd-grupo-titulo {
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: .07em;
    color: #5E8A73;
    padding: 16px 10px 6px;
}

.hd-sidebar-nav a {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 9px 10px;
    border-radius: var(--hd-radius);
    color: #BFE8CE;
    text-decoration: none;
    font-size: 13.5px;
    font-weight: 500;
    border: 1px solid transparent;
}
.hd-sidebar-nav a svg { width: 18px; height: 18px; flex-shrink: 0; stroke: currentColor; }
.hd-sidebar-nav a:hover { background: var(--hd-hover); color: var(--hd-accent); text-decoration: none; border-color: var(--hd-border); }
.hd-sidebar-nav a.ativo { background: var(--hd-accent); color: var(--hd-accent-texto); font-weight: 700; }

.hd-sidebar-footer { padding: 14px 18px 18px; border-top: 1px solid var(--hd-border); }
.hd-sidebar-footer .usuario-nome { font-size: 13px; font-weight: 600; color: var(--hd-text); }
.hd-sidebar-footer .usuario-perfil { font-size: 11.5px; color: var(--hd-text-muted); margin-bottom: 10px; }
.hd-sidebar-footer a.hd-sair {
    display: flex; align-items: center; gap: 8px;
    color: #BFE8CE; text-decoration: none; font-size: 12.5px; font-weight: 500;
}
.hd-sidebar-footer a.hd-sair svg { width: 16px; height: 16px; stroke: currentColor; }
.hd-sidebar-footer a.hd-sair:hover { color: var(--hd-accent-dark); }

.hd-main { flex: 1; min-width: 0; }

.hd-topbar {
    background: rgba(4, 20, 16, 0.45);
    border-bottom: 1px solid var(--hd-border);
    color: #fff;
    padding: 14px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
}
.hd-topbar .hd-marca-grupo { display: flex; align-items: baseline; gap: 10px; }
.hd-topbar .hd-marca { font-weight: 600; font-size: 17px; letter-spacing: .2px; color: var(--hd-text); }
.hd-topbar .hd-sub { color: var(--hd-text-muted); font-size: 13px; }

.hd-nav { display: flex; gap: 4px; }
.hd-nav a {
    color: #BFE8CE;
    text-decoration: none;
    font-size: 13.5px;
    font-weight: 500;
    padding: 7px 12px;
    border-radius: var(--hd-radius);
    border: 1px solid transparent;
}
.hd-nav a:hover { background: var(--hd-hover); color: var(--hd-accent); border-color: var(--hd-border); }
.hd-nav a.ativo { background: var(--hd-accent); color: var(--hd-accent-texto); font-weight: 700; }

.hd-container { max-width: 1280px; margin: 0 auto; padding: 24px 28px 60px; }

.hd-page-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 18px; }
.hd-page-header h1 { font-size: 20px; font-weight: 600; margin: 0 0 4px; color: var(--hd-text); }
.hd-page-header p { margin: 0; color: var(--hd-text-muted); font-size: 13px; }

.btn-hd-primary {
    background: var(--hd-accent);
    border: 1px solid var(--hd-accent);
    color: var(--hd-accent-texto);
    padding: 9px 18px;
    border-radius: var(--hd-radius);
    font-weight: 700;
    font-size: 13.5px;
    text-decoration: none;
    display: inline-block;
}
.btn-hd-primary:hover { background: var(--hd-accent-dark); border-color: var(--hd-accent-dark); color: var(--hd-accent-texto); text-decoration: none; }

.btn-hd-outline {
    background: transparent;
    border: 1px solid var(--hd-border);
    color: var(--hd-text);
    padding: 8px 14px;
    border-radius: var(--hd-radius);
    font-size: 13.5px;
    text-decoration: none;
}
.btn-hd-outline:hover { border-color: var(--hd-accent); color: var(--hd-accent); background: var(--hd-hover); text-decoration: none; }

/* --- indicadores --- */
.hd-kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 22px; }
.hd-kpi {
    background: var(--hd-surface);
    border: 1px solid var(--hd-border);
    border-radius: var(--hd-radius);
    box-shadow: var(--hd-shadow);
    padding: 16px 18px;
}
.hd-kpi .valor { font-size: 26px; font-weight: 700; color: var(--hd-accent); line-height: 1; }
.hd-kpi .rotulo { margin-top: 6px; font-size: 12.5px; color: var(--hd-text-muted); }
.hd-kpi.alerta .valor { color: var(--hd-sla-estourado); }

/* --- filtros --- */
.hd-filtros {
    background: var(--hd-surface);
    border: 1px solid var(--hd-border);
    border-radius: var(--hd-radius);
    box-shadow: var(--hd-shadow);
    padding: 16px 18px;
    margin-bottom: 18px;
}
.hd-filtros .linha { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; }
.hd-filtros .campo { display: flex; flex-direction: column; gap: 5px; }
.hd-filtros label { font-size: 12px; color: var(--hd-text-muted); font-weight: 600; }
.hd-filtros input[type="text"],
.hd-filtros input[type="email"],
.hd-filtros input[type="password"],
.hd-filtros select,
.hd-filtros textarea {
    border: 1px solid var(--hd-border);
    border-radius: var(--hd-radius);
    padding: 7px 10px;
    font-size: 13.5px;
    min-width: 160px;
    background: var(--hd-surface-alt);
    color: var(--hd-text);
}
.hd-filtros input:focus,
.hd-filtros select:focus,
.hd-filtros textarea:focus {
    outline: none;
    border-color: var(--hd-border-forte);
}
.hd-filtros .campo-check { flex-direction: row; align-items: center; gap: 6px; }
.hd-filtros .campo-check label { font-weight: 500; }

/* --- tabela --- */
.hd-tabela-wrap {
    background: var(--hd-surface);
    border: 1px solid var(--hd-border);
    border-radius: var(--hd-radius);
    box-shadow: var(--hd-shadow);
    overflow: hidden;
}
table.hd-tabela { width: 100%; border-collapse: collapse; }
table.hd-tabela thead th {
    text-align: left;
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: var(--hd-text-muted);
    background: var(--hd-surface-alt);
    padding: 11px 14px;
    border-bottom: 1px solid var(--hd-border);
}
table.hd-tabela tbody td {
    padding: 12px 14px;
    border-bottom: 1px solid var(--hd-border);
    vertical-align: middle;
    font-size: 13.5px;
    color: var(--hd-text);
}
table.hd-tabela tbody tr:last-child td { border-bottom: none; }
table.hd-tabela tbody tr:hover { background: var(--hd-hover); }

.hd-numero { font-weight: 600; color: var(--hd-accent); text-decoration: none; }
.hd-numero:hover { color: var(--hd-accent-dark); }
.hd-titulo-linha { color: var(--hd-text-muted); font-size: 12.5px; margin-top: 2px; }

.hd-badge {
    display: inline-block;
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 600;
    border: 1px solid transparent;
}
.hd-badge.status { background: rgba(182, 255, 89, 0.12); color: var(--hd-accent); border-color: var(--hd-border); }

.hd-badge.sla-ok { background: var(--hd-sla-ok-bg); color: var(--hd-sla-ok); }
.hd-badge.sla-alerta { background: var(--hd-sla-alerta-bg); color: var(--hd-sla-alerta); }
.hd-badge.sla-estourado { background: var(--hd-sla-estourado-bg); color: var(--hd-sla-estourado); }
.hd-badge.sla-encerrado { background: var(--hd-sla-encerrado-bg); color: var(--hd-sla-encerrado); }

.hd-prioridade-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; }

.hd-anexo-count { color: var(--hd-text-muted); font-size: 12.5px; }

.hd-vazio { padding: 48px 20px; text-align: center; color: var(--hd-text-muted); }

/* --- cards de chamados (substituem a tabela) --- */
.hd-ticket-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
    gap: 14px;
}

.hd-ticket-card {
    background: var(--hd-surface);
    border: 1px solid var(--hd-border);
    border-radius: var(--hd-radius);
    box-shadow: var(--hd-shadow);
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
    color: inherit;
}
.hd-ticket-card:hover { border-color: var(--hd-border-forte); background: var(--hd-hover); text-decoration: none; color: inherit; }

.hd-card-topo {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--hd-border);
}
.hd-card-topo-esq { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; min-width: 0; }
.hd-card-data { font-size: 11.5px; color: var(--hd-text-muted); white-space: nowrap; flex-shrink: 0; }
.hd-card-titulo { color: var(--hd-text-muted); font-size: 13px; }
.hd-card-topo-dir { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }

.hd-card-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px 16px; }
.hd-card-grid .item label {
    display: block;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: var(--hd-text-muted);
    margin-bottom: 3px;
}
.hd-card-grid .item .valor-campo { font-size: 13.5px; color: var(--hd-text); }
.hd-card-grid .item .valor-campo.muted { color: var(--hd-text-muted); font-size: 12.5px; }

.hd-paginacao { display: flex; justify-content: center; gap: 6px; padding: 16px; }
.hd-paginacao a, .hd-paginacao span {
    padding: 6px 11px;
    border-radius: var(--hd-radius);
    border: 1px solid var(--hd-border);
    font-size: 13px;
    text-decoration: none;
    color: var(--hd-text);
}
.hd-paginacao a:hover { border-color: var(--hd-accent); color: var(--hd-accent); background: var(--hd-hover); }
.hd-paginacao .ativa { background: var(--hd-accent); border-color: var(--hd-accent); color: var(--hd-accent-texto); font-weight: 700; }



</style>

<div class="hd-container">

        @if (TempData["Mensagem"] != null)
        {
            <div class="hd-badge sla-ok" style="margin-bottom:14px; display:block; padding:10px 14px;">@TempData["Mensagem"]</div>
        }
        @if (TempData["Erro"] != null)
        {
            <div class="hd-badge sla-estourado" style="margin-bottom:14px; display:block; padding:10px 14px;">@TempData["Erro"]</div>
        }

        <div class="hd-page-header">
            <div>
                <h1>Chamados</h1>
                <p>Acompanhe, filtre e atenda os tickets abertos, com controle de prazo de SLA.</p>
            </div>
            <a class="btn-hd-primary" href="@Url.Action("Create", "Tickets")">+ Abrir novo chamado</a>
        </div>

        <div class="hd-kpis">
            <div class="hd-kpi">
                <div class="valor">@Model.TotalAbertos</div>
                <div class="rotulo">Aguardando atendimento</div>
            </div>
            <div class="hd-kpi">
                <div class="valor">@Model.TotalEmAtendimento</div>
                <div class="rotulo">Em atendimento</div>
            </div>
            <div class="hd-kpi alerta">
                <div class="valor">@Model.TotalSlaEstourado</div>
                <div class="rotulo">Com SLA estourado</div>
            </div>
            <div class="hd-kpi">
                <div class="valor">@Model.TotalResolvidosNoMes</div>
                <div class="rotulo">Resolvidos este mês</div>
            </div>
        </div>

        <form method="get" asp-action="Index" class="hd-filtros">
            <div class="linha">
                <div class="campo">
                    <label for="Busca">Buscar</label>
                    <input type="text" id="Busca" name="Busca" placeholder="Número ou título..." value="@Model.Filtro.Busca" />
                </div>

                <div class="campo">
                    <label for="ModuloId">Módulo</label>
                    <select id="ModuloId" name="ModuloId">
                        <option value="">Todos</option>
                        @foreach (var m in Model.Modulos)
                        {
                            <option value="@m.Id" selected="@(Model.Filtro.ModuloId == m.Id)">@m.Nome</option>
                        }
                    </select>
                </div>

                <div class="campo">
                    <label for="CategoriaId">Categoria</label>
                    <select id="CategoriaId" name="CategoriaId">
                        <option value="">Todas</option>
                        @foreach (var c in Model.Categorias)
                        {
                            <option value="@c.Id" selected="@(Model.Filtro.CategoriaId == c.Id)">@c.Nome</option>
                        }
                    </select>
                </div>

                <div class="campo">
                    <label for="PrioridadeId">Prioridade</label>
                    <select id="PrioridadeId" name="PrioridadeId">
                        <option value="">Todas</option>
                        @foreach (var p in Model.Prioridades)
                        {
                            <option value="@p.Id" selected="@(Model.Filtro.PrioridadeId == p.Id)">@p.Nome</option>
                        }
                    </select>
                </div>

                <div class="campo">
                    <label for="StatusId">Status</label>
                    <select id="StatusId" name="StatusId">
                        <option value="">Todos</option>
                        @foreach (var s in Model.StatusList)
                        {
                            <option value="@s.Id" selected="@(Model.Filtro.StatusId == s.Id)">@s.Nome</option>
                        }
                    </select>
                </div>

                <div>
                    <div class="campo campo-check">
                        <input type="checkbox" id="ApenasComSlaEstourado" name="ApenasComSlaEstourado" value="true" checked="@Model.Filtro.ApenasComSlaEstourado" />
                        <label for="ApenasComSlaEstourado">Somente SLA estourado</label>
                    </div>

                    <div class="campo campo-check">
                        <input type="checkbox" id="ApenasMeusTickets" name="ApenasMeusTickets" value="true" checked="@Model.Filtro.ApenasMeusTickets" />
                        <label for="ApenasMeusTickets">Meus chamados</label>
                    </div>
                </div>

                <div class="campo">
                    <label>&nbsp;</label>
                    <button type="submit" class="btn-hd-outline">Filtrar</button>
                </div>
            </div>
        </form>

        @if (!Model.Tickets.Any())
        {
            <div class="hd-filtros hd-vazio">Nenhum chamado encontrado com os filtros selecionados.</div>
        }
        else
        {
            <div class="hd-ticket-cards">
                @foreach (var t in Model.Tickets)
                {
                    var (classeSla, textoSla) = t.Sla switch
                    {
                        HelpDesk.ViewModels.SlaSituacao.DentroDoPrazo => ("sla-ok", "Dentro do prazo"),
                        HelpDesk.ViewModels.SlaSituacao.ProximoDoLimite => ("sla-alerta", "Próximo do limite"),
                        HelpDesk.ViewModels.SlaSituacao.Estourado => ("sla-estourado", "SLA estourado"),
                        _ => ("sla-encerrado", "Encerrado")
                    };

                    <a class="hd-ticket-card" href="@Url.Action("Details", "Tickets", new { id = t.Id })">


                        <div class="hd-card-topo">
                            <div class="hd-card-topo-esq">
                                <span class="hd-numero">@t.DataAbertura.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                <span class="hd-card-titulo">@t.NumeroTicket</span>
                                <span class="valor-campo">@t.Titulo</span>
                            </div>

                            <div>
                                 <div class="item">
                                    <div class="hd-card-titulo">@(t.Modulo?.Length >= 8 ? t.Modulo.Substring(7) : t.Modulo)</div>
                                    <div class="hd-card-titulo muted">@t.Categoria</div>
                                </div>
                            </div>

                            <div class="hd-card-topo-dir">
                                <span class="hd-badge status">@t.Status</span>
                            </div>
                        </div>

                        <div class="hd-card-grid">
                            <div class="item">
                                <label>Solicitante</label>
                                <div class="valor-campo">@t.Solicitante</div>
                            </div>

                            <div class="item">
                                <label>Prioridade</label>
                                <div class="valor-campo"><span class="hd-prioridade-dot" style="background:@(t.PrioridadeCorHex ?? "#999")"></span>@t.Prioridade</div>
                            </div>

                            <div class="item">
                                <label>SLA</label>
                                <div class="valor-campo">
                                    <span class="hd-badge @classeSla">@textoSla</span>
                                    <div class="hd-titulo-linha">até @t.DataLimiteSla.ToLocalTime().ToString("dd/MM HH:mm")</div>
                                </div>
                            </div>
                            <div class="item">
                                <label>Atendente</label>
                                <div class="valor-campo muted">@(t.Atendente ?? "Não atribuído")</div>
                            </div>
                            
                             <div class="hd-card-topo-dir">
                                <span class="hd-anexo-count">@t.QuantidadeAnexos anexo(s)</span>
                            </div>
                        </div>
                    </a>
                }
            </div>

            @if (Model.TotalPaginas > 1)
            {
                <div class="hd-paginacao">
                    @for (int p = 1; p <= Model.TotalPaginas; p++)
                    {
                        if (p == Model.Filtro.PaginaAtual)
                        {
                            <span class="ativa">@p</span>
                        }
                        else
                        {
                            <a href="@Url.Action("Index", "Tickets", new {
                                Busca = Model.Filtro.Busca,
                                ModuloId = Model.Filtro.ModuloId,
                                CategoriaId = Model.Filtro.CategoriaId,
                                PrioridadeId = Model.Filtro.PrioridadeId,
                                StatusId = Model.Filtro.StatusId,
                                ApenasComSlaEstourado = Model.Filtro.ApenasComSlaEstourado,
                                ApenasMeusTickets = Model.Filtro.ApenasMeusTickets,
                                PaginaAtual = p
                            })">@p</a>
                        }
                    }
                </div>
            }
        }
    </div>
