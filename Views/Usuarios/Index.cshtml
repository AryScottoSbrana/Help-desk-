@model HelpDesk.ViewModels.UsuarioIndexViewModel
@{
    ViewData["Title"] = "Usuários";
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Help Desk — Usuários</title>
    <link rel="stylesheet" href="~/css/helpdesk.css" />
</head>
<body class="helpdesk">

    <div class="hd-topbar">
        <div class="hd-marca-grupo">
            <span class="hd-marca">Help Desk</span>
            <span class="hd-sub">Central de atendimento e suporte</span>
        </div>
        <nav class="hd-nav">
            <a href="@Url.Action("Index", "Tickets")">Chamados</a>
            <a class="ativo" href="@Url.Action("Index", "Usuarios")">Usuários</a>
        </nav>
    </div>

    <div class="hd-container">

        @if (TempData["Mensagem"] != null)
        {
            <div class="hd-badge sla-ok" style="margin-bottom:14px; display:block; padding:10px 14px;">@TempData["Mensagem"]</div>
        }

        <div class="hd-page-header">
            <div>
                <h1>Usuários</h1>
                <p>Solicitantes, atendentes e administradores com acesso ao Help Desk.</p>
            </div>
            <a class="btn-hd-primary" href="@Url.Action("Create", "Usuarios")">+ Novo usuário</a>
        </div>

        <div class="hd-tabela-wrap">
            @if (!Model.Usuarios.Any())
            {
                <div class="hd-vazio">Nenhum usuário cadastrado ainda.</div>
            }
            else
            {
                <table class="hd-tabela">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>E-mail</th>
                            <th>Perfil</th>
                            <th>Empresa</th>
                            <th>Situação</th>
                            <th>Cadastrado em</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.Usuarios)
                        {
                            <tr>
                                <td>@u.Nome</td>
                                <td>@u.Email</td>
                                <td><span class="hd-badge status">@u.Perfil</span></td>
                                <td>@u.NomeEmpresa</td>
                                <td>
                                    @if (u.Ativo)
                                    {
                                        <span class="hd-badge sla-ok">Ativo</span>
                                    }
                                    else
                                    {
                                        <span class="hd-badge sla-encerrado">Inativo</span>
                                    }
                                </td>
                                <td>@u.DataCriacao.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</body>
</html>
