@model HelpDesk.ViewModels.EmpresaCreateViewModel
@{
    ViewData["Title"] = "Nova empresa";
}
<div class="hd-container" style="max-width:560px;">

    <div class="hd-page-header">
        <div>
            <h1>Nova empresa</h1>
            <p>Cadastre um novo cliente para começar a registrar os usuários e chamados dele.</p>
        </div>
        <a class="btn-hd-outline" href="@Url.Action("Index", "Empresas")">Voltar para a lista</a>
    </div>

    <div class="hd-filtros" style="padding:24px;">

        <div asp-validation-summary="ModelOnly" class="hd-badge sla-estourado" style="display:block; padding:10px 14px; margin-bottom:16px;"></div>

        <form asp-action="Create" asp-controller="Empresas" method="post">
            @Html.AntiForgeryToken()

            <div class="campo" style="margin-bottom:16px;">
                <label asp-for="Nome">Nome da empresa</label>
                <input asp-for="Nome" type="text" style="width:100%;" placeholder="Ex.: Cliente B Comércio S.A." />
                <span asp-validation-for="Nome" class="hd-titulo-linha" style="color:var(--hd-sla-estourado);"></span>
            </div>

            <div class="campo" style="margin-bottom:22px;">
                <label asp-for="Documento">CNPJ (opcional)</label>
                <input asp-for="Documento" type="text" style="width:100%;" placeholder="00.000.000/0001-00" />
                <span asp-validation-for="Documento" class="hd-titulo-linha" style="color:var(--hd-sla-estourado);"></span>
            </div>

            <button type="submit" class="btn-hd-primary">Cadastrar empresa</button>
        </form>
    </div>

    <p class="hd-titulo-linha" style="text-align:center; margin-top:14px;">
        Depois de cadastrar, você já vai direto para o cadastro do primeiro usuário dessa empresa.
    </p>
</div>
